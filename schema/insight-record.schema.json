{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/insight-record.schema.json",
  "title": "InsightRecord",
  "description": "Matches the live code/schema inspection in docs/migration/01_verified_inventory.md and 04_data_dictionary.md (2026-09-25). Derived/recomputed aggregate, no FK.",
  "type": "object",
  "required": ["id", "sku", "issue_type", "frequency"],
  "properties": {
    "id": { "type": "string" },
    "sku": { "type": "string" },
    "carrier": { "type": "string" },
    "supplier": { "type": "string" },
    "warehouse": { "type": "string" },
    "issue_type": { "type": "string" },
    "frequency": { "type": "integer", "minimum": 0 },
    "trend_direction": { "type": "string", "enum": ["up", "down", "stable"] }
  }
}
