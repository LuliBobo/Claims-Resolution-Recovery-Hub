{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/insight-record.schema.json",
  "title": "InsightRecord",
  "description": "Maps to the 'Insight Records' entity in docs/claimflow-luo-playbook.md, Phase 1.",
  "type": "object",
  "required": ["recordId", "sku", "issueType", "frequency"],
  "properties": {
    "recordId": { "type": "string" },
    "sku": { "type": "string" },
    "productName": { "type": "string" },
    "carrierName": { "type": "string" },
    "issueType": { "type": "string" },
    "frequency": { "type": "integer", "minimum": 0 },
    "totalLossAmount": { "type": "number" }
  }
}
