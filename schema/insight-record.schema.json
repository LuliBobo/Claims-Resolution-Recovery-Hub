{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/insight-record.schema.json",
  "title": "InsightRecord",
  "type": "object",
  "required": ["sku", "issueType", "frequency"],
  "properties": {
    "sku": { "type": "string" },
    "supplierId": { "type": "string" },
    "carrier": { "type": "string" },
    "warehouse": { "type": "string" },
    "issueType": {
      "type": "string",
      "enum": ["withdrawal", "damaged_delivery", "defective_product", "wrong_item", "missing_item", "other"]
    },
    "frequency": { "type": "integer", "minimum": 0 },
    "periodStart": { "type": "string", "format": "date" },
    "periodEnd": { "type": "string", "format": "date" }
  }
}
