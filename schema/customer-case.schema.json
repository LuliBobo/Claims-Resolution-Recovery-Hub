{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/customer-case.schema.json",
  "title": "CustomerCase",
  "description": "Maps to the 'Customer Cases' entity in docs/claimflow-luo-playbook.md, Phase 1.",
  "type": "object",
  "required": ["caseId", "customerName", "language", "status", "caseType"],
  "properties": {
    "caseId": { "type": "string", "description": "Luo field: Case ID, e.g. #CAS-2026-089" },
    "customerName": { "type": "string" },
    "email": { "type": "string" },
    "language": { "type": "string", "description": "BCP-47 language tag, e.g. en, sk" },
    "orderReference": { "type": "string" },
    "channel": { "type": "string", "description": "Sales/intake channel, e.g. webshop, email" },
    "status": {
      "type": "string",
      "enum": ["new", "awaiting_evidence", "awaiting_approval", "approved", "rejected", "escalated", "closed"]
    },
    "caseType": {
      "type": "string",
      "enum": ["damaged_delivery", "wrong_item", "missing_item", "defective_product", "return_request", "other"]
    },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
