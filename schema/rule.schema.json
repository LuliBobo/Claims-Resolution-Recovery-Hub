{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/rule.schema.json",
  "title": "Rule",
  "type": "object",
  "required": ["trigger", "evidenceRequirement", "allowedResolutions"],
  "properties": {
    "trigger": { "type": "string", "description": "Condition that activates this rule, e.g. case type or evidence state" },
    "evidenceRequirement": { "type": "array", "items": { "type": "string" } },
    "allowedResolutions": {
      "type": "array",
      "items": { "type": "string", "enum": ["refund", "replacement", "partial_credit", "escalation", "rejection"] }
    },
    "escalationThreshold": { "type": "integer", "minimum": 0, "maximum": 15 },
    "policyDocumentName": { "type": "string" },
    "policyDocumentVersion": { "type": "string" }
  }
}
