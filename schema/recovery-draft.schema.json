{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/recovery-draft.schema.json",
  "title": "RecoveryDraft",
  "description": "Maps to the 'Recovery Drafts' entity in docs/claimflow-luo-playbook.md, Phase 1.",
  "type": "object",
  "required": ["recoveryId", "caseId", "counterpartyType", "counterpartyName", "status"],
  "properties": {
    "recoveryId": { "type": "string" },
    "caseId": { "type": "string" },
    "counterpartyType": { "type": "string", "enum": ["carrier", "supplier"] },
    "counterpartyName": { "type": "string" },
    "claimReason": { "type": "string" },
    "estimatedRecoverableAmount": { "type": "number" },
    "currency": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "pending_review", "submitted", "recovered"] }
  }
}
