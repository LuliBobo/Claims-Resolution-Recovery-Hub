{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/approval.schema.json",
  "title": "Approval",
  "type": "object",
  "required": ["id", "caseId", "action", "reviewer", "decision", "timestamp"],
  "properties": {
    "id": { "type": "string" },
    "caseId": { "type": "string" },
    "action": { "type": "string", "description": "Exact action being approved, e.g. customer_reply, recovery_claim" },
    "reviewer": { "type": "string" },
    "decision": { "type": "string", "enum": ["approve", "approve_with_edits", "request_more_evidence", "reject"] },
    "comment": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
