{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/order.schema.json",
  "title": "Order",
  "type": "object",
  "required": ["orderId", "date", "sku", "quantity", "salesChannel"],
  "properties": {
    "orderId": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "sku": { "type": "string" },
    "quantity": { "type": "integer", "minimum": 1 },
    "salesChannel": { "type": "string" },
    "paymentStatus": { "type": "string", "enum": ["paid", "refunded", "partially_refunded", "pending"] },
    "supplierId": { "type": "string" },
    "shipmentId": { "type": "string" }
  }
}
