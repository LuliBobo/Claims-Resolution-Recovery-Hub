{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/order.schema.json",
  "title": "Order",
  "description": "Maps to the 'Orders' entity in docs/claimflow-luo-playbook.md, Phase 1.",
  "type": "object",
  "required": ["orderId", "orderDate", "sku", "productName"],
  "properties": {
    "orderId": { "type": "string" },
    "orderDate": { "type": "string", "format": "date" },
    "sku": { "type": "string" },
    "productName": { "type": "string" },
    "itemValue": { "type": "number" },
    "currency": { "type": "string" },
    "salesChannel": { "type": "string" },
    "customerId": { "type": "string" }
  }
}
