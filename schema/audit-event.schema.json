{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/audit-event.schema.json",
  "title": "AuditEvent",
  "description": "Maps to the 'Audit Events' entity in docs/claimflow-luo-playbook.md, Phase 1.",
  "type": "object",
  "required": ["eventId", "caseId", "eventType", "actor", "timestamp"],
  "properties": {
    "eventId": { "type": "string" },
    "caseId": { "type": "string" },
    "eventType": { "type": "string" },
    "actor": { "type": "string" },
    "description": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
