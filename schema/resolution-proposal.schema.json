{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/resolution-proposal.schema.json",
  "title": "ResolutionProposal",
  "description": "Maps to the 'Resolution Proposals' entity in docs/claimflow-luo-playbook.md, Phase 1.",
  "type": "object",
  "required": ["proposalId", "caseId", "recommendedAction", "rationale"],
  "properties": {
    "proposalId": { "type": "string" },
    "caseId": { "type": "string" },
    "recommendedAction": { "type": "string", "enum": ["replacement", "refund", "store_credit", "reject"] },
    "rationale": { "type": "string" },
    "confidenceScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "estimatedCost": { "type": "number" }
  }
}
