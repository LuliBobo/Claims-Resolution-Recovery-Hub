{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/policy-document.schema.json",
  "title": "PolicyDocument",
  "description": "Maps to the 'Policy Documents' entity in docs/claimflow-luo-playbook.md, Phase 1. There is no separate Rule entity in the playbook: rule content lives in contentSummary.",
  "type": "object",
  "required": ["policyId", "title", "category", "version"],
  "properties": {
    "policyId": { "type": "string" },
    "title": { "type": "string" },
    "category": { "type": "string", "enum": ["return", "warranty", "carrier_claim"] },
    "version": { "type": "string" },
    "contentSummary": { "type": "string" }
  }
}
