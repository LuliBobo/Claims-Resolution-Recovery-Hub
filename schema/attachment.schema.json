{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/attachment.schema.json",
  "title": "Attachment",
  "description": "Maps to the 'Attachments' entity in docs/claimflow-luo-playbook.md, Phase 1.",
  "type": "object",
  "required": ["attachmentId", "caseId", "fileName", "imageCategory"],
  "properties": {
    "attachmentId": { "type": "string" },
    "caseId": { "type": "string", "description": "Linked CustomerCase.caseId" },
    "fileName": { "type": "string" },
    "imageCategory": {
      "type": "string",
      "enum": ["product", "packaging", "shipping_label", "invoice", "other"]
    },
    "status": { "type": "string", "enum": ["uploaded", "verified", "rejected"] }
  }
}
