{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claims-resolution-recovery-hub/schema/attachment.schema.json",
  "title": "Attachment",
  "type": "object",
  "required": ["id", "caseId", "fileType", "imageCategory"],
  "properties": {
    "id": { "type": "string" },
    "caseId": { "type": "string", "description": "Linked CustomerCase.id" },
    "fileType": { "type": "string", "enum": ["image", "pdf", "document"] },
    "imageCategory": {
      "type": "string",
      "enum": ["product_photo", "outer_packaging_photo", "invoice", "delivery_note", "tracking_screenshot", "other", "not_applicable"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "extractedNotes": { "type": "string" },
    "fileName": { "type": "string" },
    "uploadedAt": { "type": "string", "format": "date-time" }
  }
}
