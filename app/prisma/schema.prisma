// Claims Resolution & Recovery Hub — schema.
// Source spec: Migration/migration_handoff_public_01_verified_inventory.md §1 and
// claims-resolution-hub-multiple-proposal-supersession-migration-requirement.md (Part B.4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (ported as-is from the verified live schema) ----------

enum UserRole {
  agent
  reviewer
  admin
}

enum CaseType {
  damaged_delivery
  wrong_item
  missing_item
  return_request
  other
}

enum CasePriority {
  low
  medium
  high
  urgent
}

enum CaseSource {
  email
  chat
  phone
  marketplace
  web_form
  other
}

enum CaseStatus {
  new
  in_review
  awaiting_approval
  resolved
  escalated
  closed
}

enum AttachmentCategory {
  photo_evidence
  invoice
  shipping_label
  correspondence
  other
}

enum EvidenceStatus {
  pending_review
  sufficient
  insufficient
  not_applicable
}

enum ApprovalType {
  resolution_proposal
  recovery_draft
}

// `superseded` is new (not in Luo). It is system-replaced, never a human rejection.
enum ApprovalDecision {
  pending
  approved
  rejected
  superseded
  // A reviewer sent it back for more evidence. A recorded human decision, never a rejection.
  evidence_requested
}

enum InsightTrend {
  up
  down
  stable
}

enum PolicyDocumentType {
  policy
  terms
  carrier_agreement
  supplier_agreement
  other
}

enum RecoveryCounterpartyType {
  carrier
  supplier
}

enum RecoveryDraftStatus {
  draft
  pending_approval
  approved
  sent
  rejected
  resolved
  evidence_requested
}

// `superseded` is new (not in Luo). Never conflated with `rejected`.
enum ProposalStatus {
  pending_approval
  approved
  rejected
  sent
  superseded
  evidence_requested
}

// What a photo_evidence attachment depicts, as observed by the evidence judge (never
// inferred from the file name, which is what the Luo prototype did).
enum PhotoSubject {
  item
  outer_carton
  other
}

enum RuleTriggerType {
  damaged_delivery
  wrong_item
  missing_item
  return_request
  other
}

enum ShipmentDeliveryStatus {
  pending
  in_transit
  delivered
  delayed
  lost
  returned
}

// ---------- Auth ----------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(agent)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Reference data ----------

model Order {
  id            String   @id @default(uuid())
  orderDate     DateTime
  salesChannel  String
  customerName  String
  customerEmail String?
  customerPhone String?
  sku           String
  productName   String
  quantity      Int
  orderValue    Decimal  @db.Decimal(12, 2)
  supplier      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shipments Shipment[]
  cases     CustomerCase[]
}

model Shipment {
  id             String                 @id @default(uuid())
  linkedOrderId  String
  carrier        String
  trackingNumber String
  warehouse      String?
  shipDate       DateTime?
  deliveryDate   DateTime?
  deliveryStatus ShipmentDeliveryStatus @default(pending)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  order Order          @relation(fields: [linkedOrderId], references: [id])
  cases CustomerCase[]

  @@index([linkedOrderId])
}

model PolicyDocument {
  id           String             @id @default(uuid())
  name         String
  documentType PolicyDocumentType
  version      String?
  jurisdiction String?
  activeStatus Boolean            @default(true)
  summary      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  rules    Rule[]
  file     PolicyDocumentFile?
  passages PolicyPassage[]
}

model Rule {
  id                     String          @id @default(uuid())
  ruleName               String
  triggerType            RuleTriggerType
  requiredEvidence       String?
  recommendedResolution  String?
  escalationPath         String?
  linkedPolicyDocumentId String?
  activeStatus           Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  linkedPolicyDocument PolicyDocument? @relation(fields: [linkedPolicyDocumentId], references: [id])

  @@index([triggerType, activeStatus])
}

// ---------- Cases ----------

model CustomerCase {
  id                          String       @id @default(uuid())
  createdAt                   DateTime     @default(now())
  source                      CaseSource
  status                      CaseStatus   @default(new)
  caseType                    CaseType
  customerName                String
  customerEmail               String?
  customerPhone               String?
  customerLanguage            String       @default("en")
  orderReference              String?
  complaintText               String
  internalEnglishSummary      String?
  priority                    CasePriority @default(medium)
  linkedOrderId               String?
  linkedShipmentId            String?
  // Denormalized cache of the current proposal's recommendation text (write-through).
  resolutionRecommendation    String?
  recoveryNeeded              Boolean      @default(false)
  assignedReviewer            String?
  resolvedAt                  DateTime?
  // Set when LLM translate/classify failed at intake; case still created, needs manual triage.
  needsManualTriage           Boolean      @default(false)
  // 0..1, as reported by the classifier; null when classification was manual or failed.
  classificationConfidence    Float?
  // Operator overrides of workflow score factors: { factorKey: { score, reason, by, at } }.
  scoreOverrides              Json?
  // Single stored source of truth for "which proposal is current" (supersession Part B.2).
  currentResolutionProposalId String?      @unique

  order                     Order?              @relation(fields: [linkedOrderId], references: [id])
  shipment                  Shipment?           @relation(fields: [linkedShipmentId], references: [id])
  currentResolutionProposal ResolutionProposal? @relation("CurrentProposal", fields: [currentResolutionProposalId], references: [id], onDelete: SetNull)

  attachments         Attachment[]
  resolutionProposals ResolutionProposal[]   @relation("CaseProposals")
  recoveryDrafts      RecoveryDraft[]
  auditEvents         AuditEvent[]
  humanApprovals      HumanApproval[]
  messageDrafts       CustomerMessageDraft[]

  @@index([status])
  @@index([createdAt])
  @@index([linkedOrderId])
  @@index([linkedShipmentId])
}

model Attachment {
  id                  String             @id @default(uuid())
  linkedCaseId        String
  fileName            String
  // Untrusted value sent by the client.
  declaredContentType String
  // Detected from the actual bytes; the value everything else should trust.
  sniffedContentType  String?
  contentTypeMismatch Boolean            @default(false)
  // Set by the evidence judge for photo_evidence attachments.
  photoSubject        PhotoSubject?
  attachmentCategory  AttachmentCategory @default(other)
  aiNotes             String?
  // Why the evidence judge found this insufficient (deterministic, from the sufficiency modules).
  evidenceReason      String?
  // The single field every consumer reads to decide whether evidence is sufficient.
  evidenceStatus      EvidenceStatus     @default(pending_review)
  // Opaque storage reference (blob key / path).
  storageRef          String
  createdAt           DateTime           @default(now())

  case CustomerCase @relation(fields: [linkedCaseId], references: [id], onDelete: Cascade)

  blob AttachmentBlob?

  @@index([linkedCaseId])
}

model ResolutionProposal {
  id                  String         @id @default(uuid())
  linkedCaseId        String
  recommendation      String
  rationale           String
  confidence          Float?
  customerImpact      String?
  businessExposure    String?
  // Free text, not a real FK.
  policySource        String?
  needsHumanApproval  Boolean        @default(true)
  status              ProposalStatus @default(pending_approval)
  // AI-written, customer-facing reply in the case's customer_language.
  customerReplyDraft  String?
  // True when the deterministic evidence gate overwrote `recommendation`.
  evidenceGateApplied Boolean        @default(false)
  createdAt           DateTime       @default(now())
  supersededAt        DateTime?
  // Policy excerpts the recommendation rests on, snapshotted verbatim at generation time:
  // [{ passageId, document, version, page, excerpt }]. Empty means nothing was cited.
  citations           Json?

  case           CustomerCase    @relation("CaseProposals", fields: [linkedCaseId], references: [id], onDelete: Cascade)
  currentForCase CustomerCase?   @relation("CurrentProposal")
  approvals      HumanApproval[]

  @@index([linkedCaseId, createdAt])
}

model RecoveryDraft {
  id                        String                   @id @default(uuid())
  linkedCaseId              String
  counterpartyType          RecoveryCounterpartyType
  counterpartyName          String
  claimType                 String
  draftText                 String
  estimatedRecoverableValue Decimal?                 @db.Decimal(12, 2)
  status                    RecoveryDraftStatus      @default(draft)
  approvedAt                DateTime?
  sentAt                    DateTime?
  createdAt                 DateTime                 @default(now())

  case      CustomerCase    @relation(fields: [linkedCaseId], references: [id], onDelete: Cascade)
  approvals HumanApproval[]

  @@index([linkedCaseId])
}

model AuditEvent {
  id            String   @id @default(uuid())
  linkedCaseId  String
  eventTime     DateTime @default(now())
  actor         String
  action        String
  previousState String?
  newState      String?
  ruleSource    String?
  notes         String?

  case CustomerCase @relation(fields: [linkedCaseId], references: [id], onDelete: Cascade)

  @@index([linkedCaseId, eventTime])
}

model HumanApproval {
  id                         String           @id @default(uuid())
  linkedCaseId               String
  approvalType               ApprovalType
  linkedResolutionProposalId String?
  linkedRecoveryDraftId      String?
  reviewer                   String?
  decision                   ApprovalDecision @default(pending)
  reviewerComment            String?
  // Reserved for real human decisions only.
  decisionTime               DateTime?
  // Set when approved with edits: { field: { from, to } }. The decision itself stays "approved".
  edits                      Json?
  // Distinct from decisionTime: when the system superseded a still-pending approval.
  supersededAt               DateTime?
  createdAt                  DateTime         @default(now())

  case               CustomerCase        @relation(fields: [linkedCaseId], references: [id], onDelete: Cascade)
  resolutionProposal ResolutionProposal? @relation(fields: [linkedResolutionProposalId], references: [id])
  recoveryDraft      RecoveryDraft?      @relation(fields: [linkedRecoveryDraftId], references: [id])

  @@index([linkedCaseId])
  @@index([decision])
}

model InsightRecord {
  id             String       @id @default(uuid())
  sku            String?
  carrier        String?
  supplier       String?
  warehouse      String?
  issueType      String
  frequency      Int
  trendDirection InsightTrend @default(stable)
  createdAt      DateTime     @default(now())
}

// Output of the weekly report job (replaces Luo's write-only Knowledge Base file).
model WeeklyReport {
  id          String   @id @default(uuid())
  // Monday 00:00 UTC of the reported week; one report per week (regeneration replaces it).
  weekStart   DateTime @unique
  weekEnd     DateTime
  markdown    String
  generatedAt DateTime @default(now())
  generatedBy String
}

// File bytes, in their own table so listing attachments never loads them. Keyed by the
// attachment, so deleting an attachment (or its case) deletes the bytes too.
model AttachmentBlob {
  attachmentId String   @id
  bytes        Bytes
  createdAt    DateTime @default(now())

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

// Failed and successful sign-in attempts, used to throttle password guessing per email.
model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

enum MessageKind {
  evidence_request
}

enum MessageStatus {
  draft
  sent
  discarded
}

// A drafted message to the customer. Nothing is transmitted by the system: "sent" is a manual
// attestation that a person sent it.
model CustomerMessageDraft {
  id           String        @id @default(uuid())
  linkedCaseId String
  kind         MessageKind
  language     String
  body         String
  // What was missing when the draft was written (deterministic list the AI wrote around).
  missingItems Json
  status       MessageStatus @default(draft)
  createdBy    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sentAt       DateTime?
  sentBy       String?

  case CustomerCase @relation(fields: [linkedCaseId], references: [id], onDelete: Cascade)

  @@index([linkedCaseId, createdAt])
}

// The uploaded PDF behind a policy document (bytes + extraction summary). One file per document;
// re-uploading replaces it and its passages.
model PolicyDocumentFile {
  policyDocumentId String   @id
  fileName         String
  bytes            Bytes
  pageCount        Int
  // Pages that yielded no text (scanned images). There is no OCR.
  emptyPages       Int
  passageCount     Int
  uploadedBy       String
  uploadedAt       DateTime @default(now())

  policyDocument PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)
}

// A searchable chunk of a policy PDF, with its page. Retrieval is Postgres full-text search over `text`.
model PolicyPassage {
  id               String   @id @default(uuid())
  policyDocumentId String
  page             Int
  ordinal          Int
  text             String
  createdAt        DateTime @default(now())

  policyDocument PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)

  @@index([policyDocumentId, page, ordinal])
}
