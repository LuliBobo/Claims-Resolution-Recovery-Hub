# --- Database -----------------------------------------------------------------------------
# Runtime connection. On Vercel use your provider's POOLED endpoint (PgBouncer / Neon / Supabase pooler).
DATABASE_URL="postgresql://claims:claims@localhost:5432/claims_hub?schema=public"
# Direct (non-pooled) connection, used by migrations, the seed script and user:create when
# DATABASE_URL is a pooler. Optional locally; falls back to DATABASE_URL.
# DIRECT_DATABASE_URL=""
# Max connections per server instance (default 5; keep small on serverless).
# DB_POOL_MAX=5
# Separate DB used by integration tests (must never point at real data)
TEST_DATABASE_URL="postgresql://claims:claims@localhost:5432/claims_hub_test?schema=public"
# Separate DB recreated from scratch by the Playwright E2E run
# E2E_DATABASE_URL="postgresql://claims:claims@localhost:5432/claims_hub_e2e?schema=public"

# --- Secrets (required in production) -----------------------------------------------------
# Signs session tokens. Generate: openssl rand -base64 32
AUTH_SECRET=""
# Bearer token for /api/cron/* and the detailed /api/health. Vercel Cron sends it automatically.
# Generate: openssl rand -base64 32
CRON_SECRET=""
ANTHROPIC_API_KEY=""

# --- Optional -----------------------------------------------------------------------------
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# Upload size limit in MB (default 4; see DEPLOY.md on serverless body limits)
# MAX_UPLOAD_MB=4

# Enables the guided demo (admin-only load/reset, sample cases, tour bar). For a dedicated demo workspace only.
# DEMO_MODE=1

# NEVER set in a real deployment: swaps the AI for canned answers (E2E tests only; /api/health reports it as degraded).
# E2E_FAKE_LLM=1
