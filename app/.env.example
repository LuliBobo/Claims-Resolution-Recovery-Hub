# Separate DB used by integration tests (must never point at real data)
TEST_DATABASE_URL="postgresql://claims:claims@localhost:5432/claims_hub_test?schema=public"

# Auth.js (M1)
AUTH_SECRET=""

# Anthropic API (M3+)
ANTHROPIC_API_KEY=""

# Protects /api/cron/* route handlers (M7)
CRON_SECRET=""
